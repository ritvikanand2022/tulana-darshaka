{
  "buildCommand": "npm run build",
  "outputDirectory": ".output/public",
  "devCommand": "npm run dev",
  "installCommand": "npm install",
  "framework": "nuxtjs",
  "env": {
    "NUXT_PUBLIC_API_URL": "@api_url",
    "NUXT_PUBLIC_SITE_URL": "@site_url"
  },
  "build": {
    "env": {
      "NODE_VERSION": "18"
    }
  }
}

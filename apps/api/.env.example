# Server
NODE_ENV=development
PORT=4000

# Database
DATABASE_URL="postgresql://tulana:tulana_dev_password@localhost:5432/tulana_darshaka?schema=public"

# JWT Authentication
# Generate strong secrets: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production-use-openssl-rand-base64-32
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-super-secret-refresh-token-key-change-in-production-use-openssl-rand-base64-32
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_MAX=100
